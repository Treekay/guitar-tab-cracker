{
  "manifest_version": 3,
  "name": "Guitar Tab Cracker",
  "version": "0.1.0",
  "key": "",
  "description": "Send an accessible video from the current tab to your local Guitar Tab Cracker companion.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8787"
  }
}
